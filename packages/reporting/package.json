{
  "name": "@pandalog/reporting",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Renders structured analysis/verification/comparison artifacts, and the flight's events, into reproducible report documents. Performs no calculation. Layer 10, platform neutral.",
  "license": "UNLICENSED",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@pandalog/analysis": "workspace:*",
    "@pandalog/comparison": "workspace:*",
    "@pandalog/core-domain": "workspace:*",
    "@pandalog/events": "workspace:*",
    "@pandalog/schema": "workspace:*",
    "@pandalog/verification": "workspace:*"
  }
}
