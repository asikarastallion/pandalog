{
  "name": "pandalog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Professional Flight Data Analysis & Verification Platform",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.19",
    "pnpm": ">=9"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter @pandalog/web typecheck",
    "lint": "eslint . --ignore-pattern \"apps/**\" && eslint --config apps/web/eslint.config.js \"apps/web/**/*.ts\" \"apps/web/**/*.vue\"",
    "lint:fix": "eslint . --ignore-pattern \"apps/**\" --fix && eslint --config apps/web/eslint.config.js \"apps/web/**/*.ts\" \"apps/web/**/*.vue\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "tsc -b tsconfig.build.json && pnpm --filter @pandalog/web build",
    "clean": "tsc -b tsconfig.build.json --clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "dev:web": "pnpm --filter @pandalog/web dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^20.17.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.2",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vue": "^3.5.41",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.10"
  }
}
