{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "baseUrl": ".",
    "types": ["node"],
    "paths": {
      "@pandalog/schema": ["./packages/schema/src/index.ts"],
      "@pandalog/core-domain": ["./packages/core-domain/src/index.ts"],
      "@pandalog/ingestion": ["./packages/ingestion/src/index.ts"],
      "@pandalog/parser-ardupilot": ["./packages/parser-ardupilot/src/index.ts"],
      "@pandalog/query": ["./packages/query/src/index.ts"],
      "@pandalog/events": ["./packages/events/src/index.ts"],
      "@pandalog/analysis": ["./packages/analysis/src/index.ts"],
      "@pandalog/verification": ["./packages/verification/src/index.ts"],
      "@pandalog/pipeline": ["./packages/pipeline/src/index.ts"],
      "@pandalog/comparison": ["./packages/comparison/src/index.ts"],
      "@pandalog/reporting": ["./packages/reporting/src/index.ts"],
      "@pandalog/cli": ["./packages/cli/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
  ]
}
